    <recordUpdates>
        <name>Update_Reviewer_Account_Bank_Details</name>
        <label>Update Reviewer Account Bank Details</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.AccountId</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Account_Number__pc</field>
            <value>
                <elementReference>$Record.Account_Number__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Bank_Account_Name__pc</field>
            <value>
                <elementReference>$Record.Bank_Account_Name__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Bank_Name__pc</field>
            <value>
                <elementReference>$Record.Bank_Name__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Branch_Name__pc</field>
            <value>
                <elementReference>$Record.Branch_Name__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>IFSC_Code__pc</field>
            <value>
                <elementReference>$Record.IFSC_Code__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>PAN_Number__pc</field>
